# Copy to .env and fill locally. Never share this file.
# User account API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Bot token from @BotFather. Keep secret.
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated numeric Telegram user IDs allowed to use bot commands.
# Empty means bot replies to any user who messages it; set this for private use.
BOT_ALLOWED_USER_IDS=

# Minimum delay between outgoing actions (seconds). Keep conservative.
ACTION_DELAY_SECONDS=2
